// Tables transverses du noyau (app/core) : idempotence HTTP et outbox d'événements.
// `IdempotencyKey` vient de security.prisma (référence) : il vit ici car l'idempotence est transverse.
// Pas de clé étrangère vers `users` : le noyau ne dépend d'aucun module.

enum OutboxStatus {
  PENDING
  PUBLISHED
  DEAD
}

model IdempotencyKey {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  key            String // fourni par le client (UUID)
  endpoint       String // "POST /v1/payouts"
  requestHash    String    @map("request_hash") // même clé + corps différent = rejet 422
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body") // { contentType, body }
  lockedAt       DateTime? @map("locked_at") // requête en cours
  completedAt    DateTime? @map("completed_at")
  expiresAt      DateTime  @map("expires_at") // purge par job planifié
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([userId, key, endpoint])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// Événements de domaine écrits dans la même transaction que le ledger, publiés ensuite par un worker.
model OutboxEvent {
  id            String       @id @db.Uuid
  type          String
  aggregateId   String?      @map("aggregate_id")
  payload       Json
  occurredAt    DateTime     @map("occurred_at")
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at") // aussi utilisé comme bail (lease)
  lastError     String?      @map("last_error")
  publishedAt   DateTime?    @map("published_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

// Une ligne par (événement, listener) : garantit qu'un listener ne traite un événement qu'une fois.
model ListenerDelivery {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  listener    String
  deliveredAt DateTime @default(now()) @map("delivered_at")

  @@unique([eventId, listener])
  @@map("listener_deliveries")
}
