# ─── Application ───────────────────────────────────────────────
NODE_ENV=development            # development | test | production
APP_HOST=0.0.0.0
APP_PORT=3000
APP_VERSION=0.0.0               # injecté au build/déploiement
# APP_COMMIT=                   # SHA du commit déployé (optionnel)
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent

# ─── PostgreSQL ────────────────────────────────────────────────
# En Docker Compose, l'hôte est "postgres" ; en local, "localhost".
DATABASE_URL=postgresql://envo:CHANGE_ME@localhost:5432/envo
POSTGRES_PASSWORD=CHANGE_ME     # utilisé par docker/compose.yml

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── HTTP ──────────────────────────────────────────────────────
# Origines autorisées (CORS), séparées par des virgules. Vide = aucune origine navigateur.
CORS_ALLOWED_ORIGINS=
BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=15000
HEALTH_PROBE_TIMEOUT_MS=2000
SHUTDOWN_GRACE_MS=10000

# ─── Reverse proxy (Caddy, docker/compose.yml) ─────────────────
API_DOMAIN=localhost

# Les secrets d'authentification, de chiffrement et MeSomb seront ajoutés
# (et validés au démarrage) dans les phases qui les utilisent.
