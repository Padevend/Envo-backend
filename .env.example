# ─── Application ───────────────────────────────────────────────
NODE_ENV=development            # development | test | production
APP_HOST=0.0.0.0
APP_PORT=3000
APP_VERSION=0.0.0               # injecté au build/déploiement
# APP_COMMIT=                   # SHA du commit déployé (optionnel)
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent

# ─── PostgreSQL ────────────────────────────────────────────────
# En Docker Compose, l'hôte est "postgres" ; en local, "localhost".
DATABASE_URL=postgresql://envo:CHANGE_ME@localhost:5432/envo
POSTGRES_PASSWORD=CHANGE_ME     # utilisé par docker/compose.yml

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── HTTP ──────────────────────────────────────────────────────
# Origines autorisées (CORS), séparées par des virgules. Vide = aucune origine navigateur.
CORS_ALLOWED_ORIGINS=
BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=15000
HEALTH_PROBE_TIMEOUT_MS=2000
SHUTDOWN_GRACE_MS=10000
RATE_LIMIT_GLOBAL_PER_MINUTE=120
IDEMPOTENCY_TTL_HOURS=48
# true derrière Caddy (lit X-Forwarded-For). Laisser false si l'API est joignable directement.
TRUST_PROXY=false

# ─── Chiffrement et index aveugles (OBLIGATOIRES) ─────────────────────────────────
# Générer chaque clé : openssl rand -base64 32
# Trousseau versionné, "<version>:<clé>" séparés par des virgules. Pour une rotation : ajouter
# "2:<nouvelle clé>", passer ENCRYPTION_ACTIVE_KEY_VERSION à 2, et GARDER la version 1 pour déchiffrer.
ENCRYPTION_KEYS=1:CHANGE_ME_BASE64_32_BYTES
ENCRYPTION_ACTIVE_KEY_VERSION=1
# Clé HMAC des index aveugles, distincte des clés de chiffrement. NE JAMAIS la changer sans réindexer.
BLIND_INDEX_KEY=CHANGE_ME_BASE64_32_BYTES

# ─── Files de jobs (worker) ────────────────────────────────────────
QUEUE_PREFIX=envo
OUTBOX_RELAY_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_LEASE_MS=30000

# ─── Reverse proxy (Caddy, docker/compose.yml) ─────────────────
API_DOMAIN=localhost

# Les secrets MeSomb seront ajoutés (et validés au démarrage) en Phase 4.
